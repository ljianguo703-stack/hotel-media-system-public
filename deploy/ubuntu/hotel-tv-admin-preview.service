[Unit]
Description=Hotel TV admin interaction preview (demonstration data only)
After=network.target

[Service]
Type=simple
User=hotel-tv-preview
Group=hotel-tv-preview
WorkingDirectory=/opt/hotel-tv/current/web-preview
Environment=PYTHONUTF8=1
ExecStart=/usr/bin/python3 -m http.server 18791 --bind 0.0.0.0 --directory /opt/hotel-tv/current/web-preview
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
